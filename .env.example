# Copy to .env for local development. Never commit .env.
# In deployed environments these come from AWS Secrets Manager, not env files.

# Bureau of Labor Statistics Public Data API v2 (free registration, 500 queries/day)
# https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Census Data API (free registration)
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Socrata app token for data.cdc.gov (optional; raises throttling limits)
# https://data.cdc.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Local transport: "stdio" for MCP clients that launch the process, "http" for a local server
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3000

# Set to 1 to run live smoke tests against real agency APIs (off by default; CI uses fixtures)
LIVE_TESTS=0
