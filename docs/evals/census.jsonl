{"server": "census", "id": "CEN-pop-city-1yr", "area": "Census: population, large city", "question": "What is the population of Denver, the city?", "tool": "census_get_indicator", "args": {"place": "Denver", "kind": "city", "indicator": "population"}, "rubric": {"expectProgram": "ACS", "mustHaveValue": true, "mustCite": true, "mustFlag": "1-year.*65,000"}}
{"server": "census", "id": "CEN-income-county", "area": "Census: median household income with margin", "question": "What is the median household income in Denver County?", "tool": "census_get_indicator", "args": {"place": "Denver", "kind": "county", "indicator": "median_household_income"}, "rubric": {"expectProgram": "ACS", "mustHaveValue": true, "mustCite": true, "mustHaveMargin": true}}
{"server": "census", "id": "CEN-small-city-5yr", "area": "Judgment: small city falls to 5-year, flagged", "question": "What is the median household income in Sedona, Arizona (about 10,000 people)?", "tool": "census_get_indicator", "args": {"place": "Sedona", "kind": "city", "state": "AZ", "indicator": "median_household_income"}, "rubric": {"expectProgram": "ACS", "mustHaveValue": true, "mustCite": true, "mustHaveMargin": true, "mustFlag": "5-year.*below.*65,000", "mustNotFabricateCity": true}}
{"server": "census", "id": "CEN-1yr-requested-small", "area": "Judgment: 1-year requested below threshold", "question": "Give me the 1-year ACS median income for Sedona.", "tool": "census_get_indicator", "args": {"place": "Sedona", "kind": "city", "state": "AZ", "indicator": "median_household_income", "product": "1-year"}, "rubric": {"expectProgram": "ACS", "mustHaveValue": true, "mustFlag": "1-year.*requested.*below"}}
{"server": "census", "id": "CEN-poverty-subject", "area": "Census: subject-table percent", "question": "What share of Suffolk County, MA residents live below the poverty line?", "tool": "census_get_indicator", "args": {"place": "Suffolk County", "kind": "county", "state": "MA", "indicator": "poverty_rate"}, "rubric": {"expectProgram": "ACS", "mustHaveValue": true, "mustHaveMargin": true}}
{"server": "census", "id": "CEN-decennial", "area": "Census: decennial count", "question": "How many people did the 2020 Census count in Suffolk County, MA?", "tool": "census_get_indicator", "args": {"place": "Suffolk County", "kind": "county", "state": "MA", "indicator": "decennial_population"}, "rubric": {"expectProgram": "DEC", "mustHaveValue": true, "mustCite": true, "mustFootnote": "count.*not an estimate"}}
{"server": "census", "id": "CEN-compare-mixed", "area": "Judgment: mixed-size compare on one product", "question": "Compare median household income in Denver County and Sedona.", "tool": "census_compare_places", "args": {"indicator": "median_household_income", "places": ["Denver County", "Sedona"]}, "rubric": {"compareAllOk": true, "comparePeriodAligned": true, "mustFlag": "5-year.*Sedona"}}
{"server": "census", "id": "CEN-ambiguous", "area": "Judgment: ambiguous bare name", "question": "What is the population of Denver?", "tool": "census_get_indicator", "args": {"place": "Denver", "indicator": "population"}, "rubric": {"expectStatus": "ambiguous", "mustNotHaveValue": true}}
{"server": "census", "id": "CEN-describe", "area": "Census: source and required sentence", "question": "What does the Census server cover?", "tool": "census_describe_source", "args": {}, "rubric": {"describeAllAvailable": true, "mustHaveSentence": "This product uses the Census Bureau Data API but is not endorsed or certified by the Census Bureau."}}
