{
  "name": "@federal-mcps/server-bls",
  "version": "0.0.0",
  "description": "MCP server for U.S. Bureau of Labor Statistics data by place: LAUS, CES State & Area, QCEW, OEWS, CPI, JOLTS.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "federal-mcps-bls": "./dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/stdio.js', 0o755)\"",
    "dev:http": "tsx src/http-dev.ts"
  },
  "dependencies": {
    "@federal-mcps/core": "0.0.0",
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
