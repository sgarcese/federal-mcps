{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/data/*.json"],
  "exclude": ["src/**/*.test.ts", "src/**/__fixtures__/**"],
  "references": [
    {
      "path": "../core"
    }
  ]
}
