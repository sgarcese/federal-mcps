  },
  "dependencies": {
    "@federal-mcps/core": "0.5.0",
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "@federal-mcps/geography-build": "0.5.0",
    "@types/aws-lambda": "8.10.163",
    "@types/better-sqlite3": "9.6.0",
    "better-sqlite3": "13.0.3",
    "esbuild": "0.28.2"
  }
}
