{
  "name": "@federal-mcps/server-hud",
  "version": "0.5.0",
  "description": "MCP server for HUD User Data API statistics by place: Fair Market Rents, Income Limits, CHAS and Picture of Subsidized Households (shell, M11).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "federal-mcps-hud": "./bin/federal-mcps-hud.mjs"
  },
  "files": [
