  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "13.0.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@federal-mcps/geography-build": "0.0.0",
    "@types/better-sqlite3": "9.6.0"
  }
}
