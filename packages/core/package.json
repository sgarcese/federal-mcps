{
  "name": "@federal-mcps/core",
  "version": "0.0.0",
  "description": "Shared runtime for the federal-mcps family: geography resolver, HTTP client, provenance envelope, server shell, test helpers.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
